<resources>
    <!-- A dark theme: the page follows it through prefers-color-scheme, and the window stays black while loading. -->
    <style name="YouTubeTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/youtube_background</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="YouTubeTheme.Settings">
        <item name="android:colorAccent">@color/youtube_accent</item>
    </style>
</resources>
